{
  "id": "chamsys_magicq",
  "name": "ChamSys MagicQ",
  "port": 8000,
  "discover": {"type": "artnet", "match": ["magicq", "chamsys"]},
  "notes": "Sulla MagicQ: Setup › View Settings › Network › OSC: modo OSC attivo, porta di ricezione (consigliata 8000). Richiede la console sbloccata (Unlocked Mode); non disponibile su MQ40/MQ40N. Via OSC si comandano i playback 1–10 e le griglie di exec. La ricerca in rete usa Art-Net (ArtPoll): l'uscita Art-Net della console deve essere attiva.",
  "commands": [
    {"id": "go", "label": "GO di un playback", "address": "/pb/{pb}/go", "args": ["1"],
     "params": [{"id": "pb", "label": "Playback", "type": "int", "min": 1, "max": 10, "default": 1}]},
    {"id": "goto", "label": "GOTO CUE di un playback (salta alla cue)", "address": "/pb/{pb}/{cue}", "args": ["1"],
     "params": [{"id": "pb", "label": "Playback", "type": "int", "min": 1, "max": 10, "default": 1},
                {"id": "cue", "label": "Cue", "type": "float", "min": 0, "max": 9999, "decimals": 2, "default": 1}]},
    {"id": "exec", "label": "Exec (pulsante / fader della griglia)", "address": "/exec/{page}/{item}", "args": ["{state}"],
     "params": [{"id": "page", "label": "Pagina", "type": "int", "min": 1, "max": 100, "default": 1},
                {"id": "item", "label": "Elemento", "type": "int", "min": 1, "max": 100, "default": 1},
                {"id": "state", "label": "Azione", "type": "enum", "default": "1",
                 "items": [["1", "Attiva"], ["0", "Rilascia"]]}]},
    {"id": "exec_level", "label": "Exec: livello del fader", "address": "/exec/{page}/{item}", "args": ["{level}"],
     "params": [{"id": "page", "label": "Pagina", "type": "int", "min": 1, "max": 100, "default": 1},
                {"id": "item", "label": "Elemento", "type": "int", "min": 1, "max": 100, "default": 1},
                {"id": "level", "label": "Livello %", "type": "int", "min": 0, "max": 100, "default": 100}]},
    {"id": "dbo", "label": "DBO (Dead Black Out)", "address": "/dbo", "args": ["{state}"],
     "params": [{"id": "state", "label": "DBO", "type": "enum", "default": "0",
                 "items": [["0", "Attiva il blackout"], ["1", "Disattiva il blackout"]]}]},
    {"id": "flash", "label": "Tasto FLASH di un playback", "address": "/pb/{pb}/flash", "args": ["{state}"],
     "params": [{"id": "pb", "label": "Playback", "type": "int", "min": 1, "max": 10, "default": 1},
                {"id": "state", "label": "Tasto", "type": "enum", "default": "1",
                 "items": [["1", "Premuto (100%)"], ["0", "Rilasciato (0%)"]]}]},
    {"id": "swap", "label": "Stato SWAP (flash in modalità swap)", "address": "/swap", "args": ["{state}"],
     "params": [{"id": "state", "label": "Modalità", "type": "enum", "default": "1",
                 "items": [["1", "SWAP attivo"], ["0", "ADD (normale)"]]}],
     "help": "Nella MagicQ lo stato SWAP è globale: vale per tutti i tasti flash premuti dopo."},
    {"id": "level", "label": "Livello di un playback", "address": "/pb/{pb}", "args": ["{level}"],
     "params": [{"id": "pb", "label": "Playback", "type": "int", "min": 1, "max": 10, "default": 1},
                {"id": "level", "label": "Livello %", "type": "int", "min": 0, "max": 100, "default": 100}]},
    {"id": "pause", "label": "PAUSE di un playback", "address": "/pb/{pb}/pause", "args": ["1"],
     "params": [{"id": "pb", "label": "Playback", "type": "int", "min": 1, "max": 10, "default": 1}]},
    {"id": "release", "label": "RELEASE di un playback", "address": "/pb/{pb}/release", "args": ["1"],
     "params": [{"id": "pb", "label": "Playback", "type": "int", "min": 1, "max": 10, "default": 1}]},
    {"id": "rpc", "label": "Comando remoto (/rpc)", "address": "/rpc", "args": ["\"{text}\""],
     "params": [{"id": "text", "label": "Comandi", "type": "text", "default": ""}],
     "help": "Stringa di comandi remoti ChamSys (vedi il manuale MagicQ, «Remote control»)."}
  ]
}
